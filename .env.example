# Telegram Hisob (Userbot) Ma'lumotlari
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+998xxxxxxxxx

# Haydovchilar Guruhi ID si (Xorazm / Voha / Boshqa yo'nalishlar: Drivers Grup)
DRIVERS_GROUP_ID=-100xxxxxxxxx

# 2-Haydovchilar Guruhi ID si (Vodiy yo'nalishi: Vodiy Taxi Drivers)
DRIVERS_VODIY_GROUP_ID=-100xxxxxxxxx

# 3-Haydovchilar Guruhi ID si (Nukus-Gurlan-Urganch yo'nalishi)
DRIVERS_LOCAL_GROUP_ID=-100xxxxxxxxx

# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=your_bot_token

# Guruhlarga qo'shilganlik haqidagi hisobot boradigan shaxslar Telegram ID lari (vergul bilan)
ADMIN_IDS=12345678,87654321

# Yo'lovchi mijozlarni aniqlovchi kalit so'zlar
KEYWORDS=pochta,odam,toshkent,vodiy,nukus
